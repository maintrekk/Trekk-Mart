rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Buyers can create/edit their own profile but never grant themselves a role.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !('role' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }
    // Public storefront data. Writes only through the backend.
    match /vendors/{id}  { allow read: if true; allow write: if false; }
    match /products/{id} { allow read: if true; allow write: if false; }
    // Category list (edited by admins through the backend).
    match /config/{id} { allow read: if true; allow write: if false; }
    // Everything else (vendorPrivate, orders, slotPayments, slotRequests, slugs): backend only.
    match /{document=**} { allow read, write: if false; }
  }
}
